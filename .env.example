NUXT_PUBLIC_PARTYKIT_HOST=

# Vercel AI gateway key
AI_GATEWAY_API_KEY=

# Cloudflare D1 Database
D1_DATABASE_ID=your_d1_database_id_here

# Cloudflare R2 Storage
R2_ACCOUNT_ID=your_r2_account_id_here
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_ACCESS_KEY_SECRET=your_r2_access_key_secret_here
R2_BUCKET_NAME=blog-images

# Authentication
JWT_SECRET=your_jwt_secret_key_here_min_32_characters_long

# AI Agent Service
AI_AGENT_ENDPOINT=https://your-ai-agent-service.com/analyze
AI_AGENT_API_KEY=your_ai_agent_api_key_here

# Environment
ENVIRONMENT=development

# Cloudflare Account Info
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
